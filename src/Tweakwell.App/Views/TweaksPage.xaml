<Page
    x:Class="Tweakwell.App.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource TwBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <StackPanel Padding="28,20,28,16" Spacing="14" MaxWidth="980" HorizontalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="Choose, then preview" Style="{StaticResource PageTitle}" />
                    <TextBlock
                        Style="{StaticResource PageLead}"
                        Text="Each row says what it does and what it costs you. Apply is on the next screen, with old and new values." />
                </StackPanel>
                <StackPanel x:Name="TweakHost" Spacing="10" />
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Background="{StaticResource TwSurfaceBrush}"
            BorderBrush="{StaticResource TwLineBrush}"
            BorderThickness="0,1,0,0"
            Padding="28,14">
            <Grid MaxWidth="980" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="PreviewButton"
                        Content="Preview selected"
                        Style="{StaticResource PrimaryButton}"
                        Click="Preview_Click" />
                    <ProgressRing
                        x:Name="BusyRing"
                        Width="18"
                        Height="18"
                        IsActive="False"
                        Visibility="Collapsed"
                        Foreground="{StaticResource TwAmberBrush}" />
                    <TextBlock
                        x:Name="FooterNote"
                        VerticalAlignment="Center"
                        Style="{StaticResource PageLead}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
