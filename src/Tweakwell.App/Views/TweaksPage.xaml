<Page
    x:Class="Tweakwell.App.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource TwBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel Padding="28,28,28,20" Spacing="20" MaxWidth="1040" HorizontalAlignment="Center">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource PageEyebrow}" Text="CATALOG" />
                        <TextBlock Text="Pick, then preview" Style="{StaticResource PageTitle}" />
                        <TextBlock
                            Style="{StaticResource PageLead}"
                            Text="Each row says what it costs. Apply is the next screen, with old and new values." />
                    </StackPanel>
                    <StackPanel x:Name="TweakHost" Spacing="8" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Background="#0A0A0A"
            BorderBrush="{StaticResource TwLineBrush}"
            BorderThickness="0,1,0,0"
            Padding="28,16">
            <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Button
                        x:Name="PreviewButton"
                        Content="Preview selected"
                        Style="{StaticResource PrimaryButton}"
                        Click="Preview_Click" />
                    <ProgressRing
                        x:Name="BusyRing"
                        Width="18"
                        Height="18"
                        IsActive="False"
                        Visibility="Collapsed"
                        Foreground="{StaticResource TwAmberBrush}" />
                    <TextBlock
                        x:Name="FooterNote"
                        VerticalAlignment="Center"
                        Style="{StaticResource PageLead}" />
                </StackPanel>
                <TextBlock
                    x:Name="SelectedCount"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{StaticResource TwMutedBrush}"
                    Text="0 included" />
            </Grid>
        </Border>
    </Grid>
</Page>
