<Page
    x:Class="Tweakwell.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource TwBgBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Padding="28,20,28,32" Spacing="18" MaxWidth="720" HorizontalAlignment="Center">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <TextBlock
                FontSize="16"
                FontFamily="Segoe UI"
                Foreground="{StaticResource TwTextBrush}"
                TextWrapping="Wrap"
                Text="Every change is shown before it is applied, logged, and reversible. It will not turn a 2010 laptop into a gaming rig." />
            <TextBlock
                Style="{StaticResource PageLead}"
                Text="Open source. No telemetry, accounts, ads, or bundled software. Admin is requested only for a restore point or a power-plan switch." />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <HyperlinkButton x:Name="CoffeeLink" Content="Buy Me a Coffee" Foreground="{StaticResource TwAmberBrush}" />
                <HyperlinkButton x:Name="MpesaLink" Content="M-Pesa" Foreground="{StaticResource TwAmberBrush}" />
            </StackPanel>
            <TextBlock x:Name="MpesaNote" Style="{StaticResource PageLead}" />

            <TextBlock Text="SmartScreen" Style="{StaticResource PageTitle}" FontSize="18" />
            <TextBlock
                Style="{StaticResource PageLead}"
                Text="The release exe is unsigned. Windows may warn on first run. That is reputation, not a detection. Check the SHA-256 on the GitHub Release." />

            <HyperlinkButton x:Name="RepoLink" Content="github.com/brian-mwirigi/tweakwell" Foreground="{StaticResource TwAmberBrush}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
