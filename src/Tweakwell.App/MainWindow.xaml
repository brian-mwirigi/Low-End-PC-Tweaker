<Window
    x:Class="Tweakwell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource TwBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource TwBgBrush}"
            BorderBrush="{StaticResource TwLineBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="Tweakwell"
                        FontSize="18"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Foreground="{StaticResource TwTextBrush}" />
                    <TextBlock
                        Text="shown · logged · reversible"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        Foreground="{StaticResource TwMutedBrush}" />
                </StackPanel>

                <StackPanel
                    x:Name="NavBar"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <Button x:Name="NavScan" Content="Scan" Tag="scan" Style="{StaticResource NavPillActive}" Click="Nav_Click" />
                    <Button x:Name="NavTweaks" Content="Tweaks" Tag="tweaks" Style="{StaticResource NavPill}" Click="Nav_Click" />
                    <Button x:Name="NavHistory" Content="History" Tag="history" Style="{StaticResource NavPill}" Click="Nav_Click" />
                    <Button x:Name="NavAbout" Content="About" Tag="about" Style="{StaticResource NavPill}" Click="Nav_Click" />
                </StackPanel>

                <TextBlock
                    x:Name="ShellNote"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Segoe UI"
                    Foreground="{StaticResource TwMutedBrush}"
                    Text="Scan changes nothing" />
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" Background="{StaticResource TwBgBrush}" />
    </Grid>
</Window>
