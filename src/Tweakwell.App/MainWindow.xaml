<Window
    x:Class="Tweakwell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource TwBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource TwBgBrush}"
            BorderBrush="{StaticResource TwLineBrush}"
            BorderThickness="0,0,0,1"
            Padding="28,16,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,14">
                    <Border
                        Width="8"
                        Height="8"
                        Background="{StaticResource TwAmberBrush}"
                        VerticalAlignment="Center" />
                    <StackPanel Spacing="1">
                        <TextBlock
                            Text="TWEAKWELL"
                            FontSize="13"
                            FontWeight="SemiBold"
                            CharacterSpacing="140"
                            FontFamily="Segoe UI"
                            Foreground="{StaticResource TwTextBrush}" />
                        <TextBlock
                            Text="low-end windows"
                            FontSize="11"
                            FontFamily="Segoe UI"
                            Foreground="{StaticResource TwMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="NavBar"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Spacing="4">
                    <Button x:Name="NavScan" Content="Scan" Tag="scan" Style="{StaticResource NavPillActive}" Click="Nav_Click" />
                    <Button x:Name="NavTweaks" Content="Tweaks" Tag="tweaks" Style="{StaticResource NavPill}" Click="Nav_Click" />
                    <Button x:Name="NavHistory" Content="History" Tag="history" Style="{StaticResource NavPill}" Click="Nav_Click" />
                    <Button x:Name="NavAbout" Content="About" Tag="about" Style="{StaticResource NavPill}" Click="Nav_Click" />
                </StackPanel>

                <TextBlock
                    x:Name="ShellNote"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,0,14"
                    FontSize="11"
                    FontFamily="Consolas"
                    Foreground="{StaticResource TwMutedBrush}"
                    Text="read only" />
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" Background="{StaticResource TwBgBrush}" />
    </Grid>
</Window>
