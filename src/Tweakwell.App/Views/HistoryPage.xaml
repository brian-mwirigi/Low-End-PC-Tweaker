<Page
    x:Class="Tweakwell.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="880">
            <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="What changed, and when. Undo puts the previous registry or power-plan values back. Deleted temp files stay deleted."
                TextWrapping="Wrap"
                Opacity="0.7" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Restore everything" Click="RestoreAll_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Undo one tweak" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="UndoHost" Spacing="8" />

            <TextBlock Text="Log" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="LogList" SelectionMode="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
