<Page
    x:Class="Tweakwell.App.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="880">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Scan" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Read-only. Nothing on this page writes the registry, power plan, or disk."
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    Content="Scan again"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Refresh_Click" />
            </Grid>

            <TextBlock x:Name="StatusText" Opacity="0.7" />

            <TextBlock Text="Findings" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="FindingsPanel" Spacing="8" />

            <TextBlock Text="Hardware" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CPU" Opacity="0.6" />
                        <TextBlock x:Name="CpuText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="RAM" Opacity="0.6" />
                        <TextBlock x:Name="RamText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Spacing="8">
                <TextBlock Text="GPU" Opacity="0.6" />
                <StackPanel x:Name="GpuPanel" Spacing="4" />
                <TextBlock Text="Storage" Opacity="0.6" Margin="0,8,0,0" />
                <StackPanel x:Name="StoragePanel" Spacing="4" />
                <TextBlock Text="Power plan" Opacity="0.6" Margin="0,8,0,0" />
                <TextBlock x:Name="PowerText" TextWrapping="Wrap" />
                <TextBlock Text="Processes" Opacity="0.6" Margin="0,8,0,0" />
                <TextBlock x:Name="ProcessText" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Startup apps" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Local Machine entries are listed only. Disable them from Task Manager if you need to."
                Opacity="0.7"
                TextWrapping="Wrap" />
            <ListView x:Name="StartupList" SelectionMode="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
