<Page
    x:Class="Tweakwell.App.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Tweaks" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Flip the ones you want. Preview lists every key, scheme, or folder. Nothing is written until you confirm."
                TextWrapping="Wrap"
                Opacity="0.7" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="TweakHost" Spacing="12" MaxWidth="880" HorizontalAlignment="Left" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <Button
                x:Name="PreviewButton"
                Content="Preview selected"
                Style="{StaticResource AccentButtonStyle}"
                Click="Preview_Click" />
            <TextBlock
                x:Name="FooterNote"
                VerticalAlignment="Center"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
