<Page
    x:Class="Tweakwell.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="About / Support" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Tweakwell shows every change before it is applied, logs it, and reverses it when it can. It will not turn a 2010 laptop into a gaming rig."
                TextWrapping="Wrap" />
            <TextBlock
                Text="Open source. No telemetry. No accounts. No ads. No bundled software. Admin is requested only for a restore point or a power-plan switch."
                TextWrapping="Wrap"
                Opacity="0.8" />

            <TextBlock Text="Tip" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton x:Name="CoffeeLink" Content="Buy Me a Coffee" />
                <HyperlinkButton x:Name="MpesaLink" Content="M-Pesa" />
            </StackPanel>
            <TextBlock x:Name="MpesaNote" TextWrapping="Wrap" Opacity="0.8" />

            <TextBlock Text="SmartScreen" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="The release exe is unsigned. Windows may warn on first run. That is reputation, not a detection. Check the SHA-256 on the GitHub Release and the VirusTotal link in the notes."
                TextWrapping="Wrap"
                Opacity="0.8" />

            <HyperlinkButton x:Name="RepoLink" Content="github.com/brian-mwirigi/tweakwell" />
        </StackPanel>
    </ScrollViewer>
</Page>
